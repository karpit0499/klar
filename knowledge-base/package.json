{
  "name": "klar-knowledge-base",
  "version": "2.6.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:build": "node scripts/build-content.mjs",
    "predev": "npm run content:build",
    "dev": "next dev",
    "prebuild": "npm run content:build",
    "build": "next build",
    "pdf:build": "python3 scripts/export-handbooks.py --generated-on 2026-08-11",
    "pdf:repro": "npm run content:build && python3 scripts/check-reproducible-handbooks.py",
    "pdf:verify": "python3 scripts/verify-handbooks.py",
    "start": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "qa": "npm run content:build && npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}

{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "klar-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://karpit0499.github.io"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}

# Copy to .env.local and fill in after you deploy your Worker.
# Required for reliable browser-based Groq access and live proxied job sources.
# The URL of YOUR Cloudflare Worker, no trailing slash:
VITE_WORKER_URL=https://klar-proxy.<your-subdomain>.workers.dev

# Cloudflare's fixed always-pass public site key for localhost QA. Put the
# production widget's public key only in the GitHub Actions variable. Never put
# either Turnstile secret in a VITE_ variable.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional. Public GitHub Pages Knowledge Base root, without a trailing slash.
VITE_KB_URL=https://<your-github-name>.github.io/klar/kb

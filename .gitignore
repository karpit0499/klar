# --- Dependencies ---
node_modules/
worker/node_modules/

# --- Build output ---
dist/
build/
release/
*.local

# Downloaded, checksum-verified desktop runtimes are build inputs, not source.
desktop/vendor/*/*
!desktop/vendor/*/README.md
desktop/resources/trust/model-signing-public.pem
# Generated benchmark responses can contain model output and machine evidence.
model/benchmarks/reports/*.json
!model/benchmarks/reports/README.md

# --- Secrets & environment (NEVER commit these) ---
.env
.env.*
!.env.example
worker/.dev.vars
worker/.env

# --- Cloudflare / Wrangler ---
.wrangler/
worker/.wrangler/

# --- Vite / tooling cache ---
.vite/
*.tsbuildinfo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors & OS junk ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
AGENTS.md

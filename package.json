{
  "name": "klar",
  "private": true,
  "version": "2.5.3-3",
  "klarRelease": "2.5.3.3",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "for f in test/*.test.ts; do npx tsx \"$f\" || exit 1; done",
    "worker:types:check": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc --include-runtime false --check",
    "worker:check": "tsc --noEmit -p worker/tsconfig.json",
    "worker:dry-run": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "qa": "node --check public/sw.js && npm run typecheck && npm run worker:types:check && npm run worker:check && npm test && npm run build && npm run worker:dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^1.1.7",
    "docx": "^9.7.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.114.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klar.invalid/schemas/model-checksums.v1.json",
  "title": "Klar local model checksums",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "algorithm", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "algorithm": { "const": "sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
